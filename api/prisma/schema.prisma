// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum UserStatus {
  ONLINE
  AWAY
  DND
  OFFLINE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  firstName    String       @map("first_name")
  lastName     String       @map("last_name")
  avatarUrl    String?      @map("avatar_url")
  timezone     String?
  status       UserStatus   @default(OFFLINE)
  authProvider AuthProvider @map("auth_provider")
  externalId   String?      @map("external_id")
  passwordHash String?      @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  teamMembers   TeamMember[]
  refreshTokens RefreshToken[]

  @@unique([authProvider, externalId])
  @@index([email])
  @@map("users")
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members TeamMember[]
  tasks   Task[]

  @@map("teams")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     TeamRole
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasksAssigned Task[]        @relation("TaskAssignee")
  tasksReported Task[]        @relation("TaskReporter")
  taskComments  TaskComment[]

  @@id([teamId, userId])
  @@index([userId])
  @@index([teamId, role])
  @@map("team_members")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  teamId         String       @map("team_id") @db.Uuid
  title          String
  description    String?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  assigneeUserId String?      @map("assignee_user_id") @db.Uuid
  reporterUserId String?      @map("reporter_user_id") @db.Uuid
  dueDate        DateTime?    @map("due_date") @db.Date
  labels         String[]     @default([])
  parentTaskId   String?      @map("parent_task_id") @db.Uuid
  position       Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  team       Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee   TeamMember?   @relation("TaskAssignee", fields: [teamId, assigneeUserId], references: [teamId, userId], onDelete: NoAction, onUpdate: NoAction)
  reporter   TeamMember?   @relation("TaskReporter", fields: [teamId, reporterUserId], references: [teamId, userId], onDelete: NoAction, onUpdate: NoAction)
  parentTask Task?         @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[]        @relation("Subtasks")
  comments   TaskComment[]

  @@index([teamId, status, position])
  @@index([teamId, assigneeUserId])
  @@index([teamId, createdAt])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskComment {
  id           String    @id @default(uuid()) @db.Uuid
  taskId       String    @map("task_id") @db.Uuid
  teamId       String    @map("team_id") @db.Uuid
  authorUserId String?   @map("author_user_id") @db.Uuid
  content      String
  createdAt    DateTime  @default(now()) @map("created_at")
  editedAt     DateTime? @map("edited_at")

  task   Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author TeamMember? @relation(fields: [teamId, authorUserId], references: [teamId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId, createdAt])
  @@index([teamId, authorUserId])
  @@map("task_comments")
}
