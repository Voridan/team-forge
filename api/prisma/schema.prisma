// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum UserStatus {
  ONLINE
  AWAY
  DND
  OFFLINE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ChannelType {
  PUBLIC
  PRIVATE
}

enum AttachmentStatus {
  PENDING
  UPLOADED
  LINKED
}

enum CallStatus {
  ACTIVE
  ENDED
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  firstName    String       @map("first_name")
  lastName     String       @map("last_name")
  avatarUrl    String?      @map("avatar_url")
  timezone     String?
  status       UserStatus   @default(OFFLINE)
  authProvider AuthProvider @map("auth_provider")
  externalId   String?      @map("external_id")
  passwordHash String?      @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  teamMembers   TeamMember[]
  refreshTokens RefreshToken[]

  @@unique([authProvider, externalId])
  @@index([email])
  @@map("users")
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members           TeamMember[]
  tasks             Task[]
  invitations       TeamInvitation[]
  channels          Channel[]
  calls             Call[]
  analyticsSettings TeamAnalyticsSettings?

  @@map("teams")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     TeamRole
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasksAssigned       Task[]              @relation("TaskAssignee")
  tasksReported       Task[]              @relation("TaskReporter")
  taskComments        TaskComment[]
  taskStatusChanges   TaskStatusHistory[]
  invitationsSent     TeamInvitation[]
  messages            Message[]
  attachments         Attachment[]
  callsStarted        Call[]
  callParticipations  CallParticipant[]

  @@id([teamId, userId])
  @@index([userId])
  @@index([teamId, role])
  @@map("team_members")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  teamId         String       @map("team_id") @db.Uuid
  title          String
  description    String?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  assigneeUserId String?      @map("assignee_user_id") @db.Uuid
  reporterUserId String?      @map("reporter_user_id") @db.Uuid
  dueDate        DateTime?    @map("due_date") @db.Date
  labels         String[]     @default([])
  parentTaskId   String?      @map("parent_task_id") @db.Uuid
  position       Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  team          Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee      TeamMember?         @relation("TaskAssignee", fields: [teamId, assigneeUserId], references: [teamId, userId], onDelete: NoAction, onUpdate: NoAction)
  reporter      TeamMember?         @relation("TaskReporter", fields: [teamId, reporterUserId], references: [teamId, userId], onDelete: NoAction, onUpdate: NoAction)
  parentTask    Task?               @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks      Task[]              @relation("Subtasks")
  comments      TaskComment[]
  statusHistory TaskStatusHistory[]

  @@index([teamId, status, position])
  @@index([teamId, assigneeUserId])
  @@index([teamId, createdAt])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskStatusHistory {
  id              String      @id @default(uuid()) @db.Uuid
  taskId          String      @map("task_id") @db.Uuid
  teamId          String      @map("team_id") @db.Uuid
  fromStatus      TaskStatus? @map("from_status")
  toStatus        TaskStatus  @map("to_status")
  changedByUserId String?     @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime    @default(now()) @map("changed_at")

  task      Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy TeamMember? @relation(fields: [teamId, changedByUserId], references: [teamId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId, changedAt])
  @@index([teamId, toStatus, changedAt])
  @@map("task_status_history")
}

model TeamAnalyticsSettings {
  teamId String @id @map("team_id") @db.Uuid

  workloadMaxMedianWarn Float @map("workload_max_median_warn")
  workloadMaxMedianCrit Float @map("workload_max_median_crit")
  reviewP75DaysWarn     Float @map("review_p75_days_warn")
  reviewP75DaysCrit     Float @map("review_p75_days_crit")
  throughputDropPctWarn Float @map("throughput_drop_pct_warn")
  throughputDropPctCrit Float @map("throughput_drop_pct_crit")
  overdueCountWarn      Int   @map("overdue_count_warn")
  overdueCountCrit      Int   @map("overdue_count_crit")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_analytics_settings")
}

model TaskComment {
  id           String    @id @default(uuid()) @db.Uuid
  taskId       String    @map("task_id") @db.Uuid
  teamId       String    @map("team_id") @db.Uuid
  authorUserId String?   @map("author_user_id") @db.Uuid
  content      String
  createdAt    DateTime  @default(now()) @map("created_at")
  editedAt     DateTime? @map("edited_at")

  task   Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author TeamMember? @relation(fields: [teamId, authorUserId], references: [teamId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskId, createdAt])
  @@index([teamId, authorUserId])
  @@map("task_comments")
}

model TeamInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  teamId          String           @map("team_id") @db.Uuid
  email           String
  role            TeamRole         @default(MEMBER)
  invitedByUserId String?          @map("invited_by_user_id") @db.Uuid
  tokenHash       String           @unique @map("token_hash")
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime         @map("expires_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  acceptedAt      DateTime?        @map("accepted_at")

  team      Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy TeamMember? @relation(fields: [teamId, invitedByUserId], references: [teamId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([teamId, status])
  @@index([email])
  @@index([expiresAt])
  @@map("team_invitations")
}

model Channel {
  id          String      @id @default(uuid()) @db.Uuid
  teamId      String      @map("team_id") @db.Uuid
  name        String
  description String?
  type        ChannelType @default(PUBLIC)
  archivedAt  DateTime?   @map("archived_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([teamId, name])
  @@index([teamId, archivedAt])
  @@map("channels")
}

model Message {
  id           String    @id @default(uuid()) @db.Uuid
  channelId    String    @map("channel_id") @db.Uuid
  teamId       String    @map("team_id") @db.Uuid
  authorUserId String?   @map("author_user_id") @db.Uuid
  content      String
  createdAt    DateTime  @default(now()) @map("created_at")
  editedAt     DateTime? @map("edited_at")
  deletedAt    DateTime? @map("deleted_at")

  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      TeamMember?  @relation(fields: [teamId, authorUserId], references: [teamId, userId], onDelete: NoAction, onUpdate: NoAction)
  attachments Attachment[]

  @@index([channelId, createdAt])
  @@index([teamId, authorUserId])
  @@map("messages")
}

model Attachment {
  id              String           @id @default(uuid()) @db.Uuid
  teamId          String           @map("team_id") @db.Uuid
  uploaderUserId  String?          @map("uploader_user_id") @db.Uuid
  storageKey      String           @unique @map("storage_key")
  filename        String
  mimeType        String           @map("mime_type")
  sizeBytes       Int              @map("size_bytes")
  status          AttachmentStatus @default(PENDING)
  linkedMessageId String?          @map("linked_message_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  uploadedAt      DateTime?        @map("uploaded_at")

  uploader TeamMember? @relation(fields: [teamId, uploaderUserId], references: [teamId, userId], onDelete: NoAction, onUpdate: NoAction)
  message  Message?    @relation(fields: [linkedMessageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([linkedMessageId])
  @@index([teamId, uploaderUserId])
  @@map("attachments")
}

model Call {
  id              String     @id @default(uuid()) @db.Uuid
  teamId          String     @map("team_id") @db.Uuid
  status          CallStatus @default(ACTIVE)
  roomName        String     @unique @map("room_name")
  startedByUserId String?    @map("started_by_user_id") @db.Uuid
  startedAt       DateTime   @default(now()) @map("started_at")
  endedAt         DateTime?  @map("ended_at")
  durationSec     Int?       @map("duration_sec")

  team         Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  startedBy    TeamMember?       @relation(fields: [teamId, startedByUserId], references: [teamId, userId], onDelete: NoAction, onUpdate: NoAction)
  participants CallParticipant[]

  @@index([teamId, status])
  @@index([teamId, startedAt])
  @@map("calls")
}

model CallParticipant {
  callId   String    @map("call_id") @db.Uuid
  teamId   String    @map("team_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  call   Call       @relation(fields: [callId], references: [id], onDelete: Cascade)
  member TeamMember @relation(fields: [teamId, userId], references: [teamId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@id([callId, userId])
  @@index([teamId, userId])
  @@map("call_participants")
}
