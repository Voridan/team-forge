VITE_API_BASE_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
# Dev-only: direct URL to the realtime service so the browser bypasses Vite's
# WebSocket proxy (known to drop the Connection: Upgrade header for Socket.IO).
# Leave empty in prod — the browser will connect via the page origin through Nginx.
VITE_REALTIME_URL=http://localhost:3001
